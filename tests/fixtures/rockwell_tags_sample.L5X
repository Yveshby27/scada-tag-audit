        <Description><![CDATA[Valve 1 command]]></Description>
      </Tag>
      <Tag Name="HighTempAlarm" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write">
        <Description><![CDATA[High temperature alarm]]></Description>
      </Tag>
      <Tag Name="Pump_2_Run" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write">
        <Description><![CDATA[Pump 2 run status - PLC uses Pump_2_Run naming]]></Description>
      </Tag>
      <Tag Name="Temp_1_C" TagType="Base" DataType="REAL" Radix="Float" ExternalAccess="Read/Write">
        <Description><![CDATA[Temperature sensor 1]]></Description>

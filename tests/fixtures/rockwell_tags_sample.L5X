<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.00" TargetName="ExampleController" TargetType="Controller" ContainsContext="false" ExportDate="Fri Aug 15 2026" ExportOptions="References DecoratedData ForceProtectedEncoding AllProjDocTrans">
  <Controller Use="Target" Name="ExampleController" ProcessorType="1756-L83E" MajorRev="32" MinorRev="11">
    <Tags>
      <Tag Name="Motor1_Run" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write">
        <Description><![CDATA[Motor 1 run status]]></Description>
      </Tag>

      <Tag Name="UnusedPlcTag_1" TagType="Base" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
        <Description><![CDATA[PLC internal counter not exposed to HMI - orphaned PLC tag]]></Description>
      </Tag>
      <Tag Name="UnusedPlcTag_2" TagType="Base" DataType="REAL" Radix="Float" ExternalAccess="Read/Write">
